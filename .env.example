# Environment Configuration for Telegram Export Parser
# Copy this file to .env and fill in actual values for local development
# NEVER commit .env file - it contains secrets!

# Database Configuration
DATABASE_URL=sqlite:///./telegram_export.db
# Examples: sqlite:///./telegram_export.db, postgresql://user:pass@host/db

# API Keys and Secrets
SECRET_KEY=your-secret-key-here-change-in-production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Stripe Integration (optional)
STRIPE_API_KEY=sk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here

# Monitoring (optional)
SENTRY_DSN=https://your-sentry-key@sentry.io/project-id
ENV=development          # development, staging, production
APP_VERSION=1.0.0        # release version for Sentry

# Redis (optional - required for background worker)
REDIS_URL=redis://localhost:6379/0
