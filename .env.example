# Environment Configuration for Telegram Export Parser
# Copy this file to .env and fill in actual values for local development
# NEVER commit .env file - it contains secrets!

# Database Configuration
DATABASE_URL=sqlite:///./telegram_export.db
# Example formats:
# SQLite: sqlite:///./telegram_export.db
# PostgreSQL: postgresql://user:password@localhost/dbname
# MySQL: mysql://user:password@localhost/dbname

# API Keys and Secrets
SECRET_KEY=your-secret-key-here-change-in-production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Optional: Stripe Integration
STRIPE_API_KEY=sk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here

# Optional: Error Tracking (Sentry)
SENTRY_DSN=https://your-sentry-key@sentry.io/project-id

# Optional: Redis Caching
REDIS_URL=redis://localhost:6379/0
# Format: redis://[username:password@]host:port/db

# Frontend and Backend URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000/api

# Application Settings
DEBUG=False
# Set to True for development only!
# NEVER set to True in production!

ENVIRONMENT=development
# Options: development, staging, production

LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# File Upload Settings
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIRECTORY=./uploads

# Export Settings
EXPORT_DIRECTORY=./telegram_output
DEFAULT_EXPORT_FORMAT=txt
# Options: txt, csv, json, html, md, xlsx

# Feature Flags
ENABLE_STATS=False
ENABLE_AUTO_TRANSLATE=False
TRANSLATION_LANGUAGE=en
MAX_MESSAGE_LENGTH=0
# 0 means unlimited

# UI Theme
THEME=light
# Options: light, dark

# Optional: OpenAI Integration (for features like auto-translation)
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: Additional Third-party Services
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here
